{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowPet",
  "version": "0.0.9",
  "identifier": "com.seakmengs.windowpet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "WindowPet",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "decorations": false,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "asset: https://asset.localhost"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": "all",
    "copyright": "Copyright (c) 2023 Seakmeng",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERTQ3OTFEMzhDNTJEOUEKUldTYUxjVTRIWG5rYmFYak50OVBjTnBORHQ5TE5WeHJDMGNHbEJZdWxoa0RvbFEyUDVPSno1NTEK",
      "endpoints": [
        "https://github.com/SeakMengs/WindowPet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}