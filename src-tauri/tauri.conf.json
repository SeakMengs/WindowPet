{
  "productName": "WindowPet",
  "version": "0.0.9",
  "identifier": "WindowPet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: asset: https://asset.localhost; img-src 'self' asset: data: https://asset.localhost; connect-src 'self' https://api.github.com"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": true,
        "resizable": false,
        "title": "WindowPet",
        "width": 64,
        "height": 64,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright (c) 2023 Seakmeng",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERTQ3OTFEMzhDNTJEOUEKUldTYUxjVTRIWG5rYmFYak50OVBjTnBORHQ5TE5WeHJDMGNHbEJZdWxoa0RvbFEyUDVPSno1NTEK",
      "endpoints": ["https://github.com/SeakMengs/WindowPet/releases/latest/download/latest.json"]
    }
  }
}